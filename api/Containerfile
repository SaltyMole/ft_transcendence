FROM node:22-alpine

WORKDIR /app/api
RUN apk add --no-cache openssl curl

COPY package*.json ./
RUN npm ci

COPY . .
RUN mkdir -p /app/api/certs && \
    openssl req -x509 -newkey rsa:2048 -keyout /app/api/certs/key.pem -out /app/api/certs/cert.pem \
        -days 365 -nodes -subj "/CN=localhost" \
        -addext "subjectAltName=IP:127.0.0.1,DNS:localhost"

ENV NODE_ENV=production
ENV APP_STAGE=production
EXPOSE 3000
CMD ["sh", "-lc", "npx drizzle-kit push --force && npm start"]
